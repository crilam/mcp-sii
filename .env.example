# Plantilla del .env. Copiar a `.env` y completar. El `.env` está en .gitignore
# y NO se versiona: son claves tributarias reales.
#
# ---------------------------------------------------------------------------
# Perfiles de verificación contra el SII real
# ---------------------------------------------------------------------------
# Hacen falta TRES, porque lo que un contribuyente puede consultar depende de
# qué es y de cómo factura. Con un solo RUT no se puede verificar el servicio
# entero, y peor: la ronda 2 (mipyme) se descubrió bloqueada recién al relevar
# el portal, porque el RUT cargado no estaba inscrito en Facturación Gratuita.
#
# Ninguno sustituye a otro: `perfilesVerificacion.ts` falla explícito si falta
# el que se pide, en vez de caer en otra credencial y devolver un resultado que
# no dice nada sobre lo que se quería probar.

# Persona natural. Verifica: BHE emitidas y recibidas, bienes raíces, renta.
SII_PERSONA_RUT=
SII_PERSONA_CLAVE=

# Contribuyente INSCRITO en Facturación Gratuita del SII (portal mipyme).
# Es el único perfil que puede relevar mipyme: si el RUT no está inscrito, el
# selector de empresas del portal viene sin una sola opción y no hay nada que
# consultar. Verifica: list-empresas, DTE emitidos y recibidos del portal,
# borradores, PDF y XML.
SII_MIPYME_RUT=
SII_MIPYME_CLAVE=

# Contribuyente que emite con software de MERCADO (un facturador privado, no el
# portal del SII). Sus DTE viven en el RCV y en las consultas de documentos,
# pero no en mipyme. Es el perfil que representa a la mayoría de los clientes
# reales. Verifica: RCV resumen y detalle, DTE emitidos y recibidos, F29.
SII_MERCADO_RUT=
SII_MERCADO_CLAVE=

# ---------------------------------------------------------------------------
# Certificado digital
# ---------------------------------------------------------------------------
# Sólo lo exige `mipyme/emitir-dte`: firmar un DTE necesita el certificado de
# verdad. Todas las demás rutas andan con clave tributaria (PR #55).
SII_CERT_PATH=
SII_CERT_PASSWORD=
# Clave tributaria del titular del certificado, cuando el SII la pide además
# del certificado.
SII_CERT_CLAVE_SII=

# ---------------------------------------------------------------------------
# Legado: una sola credencial por proceso
# ---------------------------------------------------------------------------
# El modo de un solo contribuyente, anterior al login por sesión. El adaptador
# REST multi-tenant no las usa.
SII_RUT=
SII_CLAVE=
SII_EMPRESA_RUT=
SII_EMPRESA_CLAVE=

# ---------------------------------------------------------------------------
# Ritmo de las consultas
# ---------------------------------------------------------------------------
# Pausa entre llamadas de un barrido, en milisegundos. Sólo puede hacerla MÁS
# lenta que el piso de 1200 ms: el SII bloquea por patrón de uso, y un barrido
# sin pausa deja al servicio sin ese portal para los tenants reales.
# RITMO_SII_MS=1200
