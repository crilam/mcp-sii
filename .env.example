# Plantilla del .env. Copiar a `.env` y completar. El `.env` está en .gitignore
# y NO se versiona: son claves tributarias reales.
#
# ---------------------------------------------------------------------------
# Perfiles de verificación contra el SII real
# ---------------------------------------------------------------------------
# Hacen falta CUATRO, porque lo que un contribuyente puede consultar depende de
# qué es y de cómo factura — y porque el certificado es otra forma de entrar.
# Con un solo RUT no se verifica el servicio entero, y peor: la ronda 2 se dio
# por bloqueada porque el RUT cargado no estaba inscrito en Facturación
# Gratuita, cuando el titular del certificado sí lo estaba. La credencial
# equivocada no dice "no tenés acceso", dice "no hay datos".
#
# Ninguno sustituye a otro: `perfilesVerificacion.ts` falla explícito si falta
# el que se pide, en vez de caer en otra credencial y devolver un resultado que
# no dice nada sobre lo que se quería probar.

# Persona natural. Verifica: BHE emitidas y recibidas, bienes raíces, renta.
SII_PERSONA_RUT=
SII_PERSONA_CLAVE=

# Contribuyente INSCRITO en Facturación Gratuita del SII (portal mipyme).
# Es el único perfil que puede relevar mipyme: si el RUT no está inscrito, el
# selector de empresas del portal viene sin una sola opción y no hay nada que
# consultar. Verifica: list-empresas, DTE emitidos y recibidos del portal,
# borradores, PDF y XML.
SII_MIPYME_RUT=
SII_MIPYME_CLAVE=

# Contribuyente que emite con software de MERCADO (un facturador privado, no el
# portal del SII). Sus DTE viven en el RCV y en las consultas de documentos,
# pero no en mipyme. Es el perfil que representa a la mayoría de los clientes
# reales. Verifica: RCV resumen y detalle, DTE emitidos y recibidos, F29.
SII_MERCADO_RUT=
SII_MERCADO_CLAVE=

# Cuarto perfil: CERTIFICADO DIGITAL. No es otro contribuyente, es la otra
# forma de autenticar — y la única con la que se puede FIRMAR, que es lo que
# exige `mipyme/emitir-dte`. Todo el resto anda con clave tributaria (PR #55).
#
# El .env guarda la RUTA del .pfx, no su contenido: es un binario de varios KB
# y meterlo en una variable lo vuelve ilegible y fácil de truncar. La conversión
# a base64 que piden las rutas REST la hace perfilesVerificacion.ts. Se acepta
# `~` al principio de la ruta.
SII_CERT_PATH=
SII_CERT_PASSWORD=
# Titular del certificado. Variable propia y no `SII_RUT`: el legado usa esa
# para otra cosa, y adivinar el titular haría firmar como un contribuyente que
# nadie eligió.
SII_CERT_RUT=
# Clave tributaria del titular del certificado, cuando el SII la pide además
# del certificado.
SII_CERT_CLAVE_SII=

# ---------------------------------------------------------------------------
# Legado: una sola credencial por proceso
# ---------------------------------------------------------------------------
# El modo de un solo contribuyente, anterior al login por sesión. El adaptador
# REST multi-tenant no las usa.
SII_RUT=
SII_CLAVE=
SII_EMPRESA_RUT=
SII_EMPRESA_CLAVE=

# ---------------------------------------------------------------------------
# Ritmo de las consultas
# ---------------------------------------------------------------------------
# Pausa entre llamadas de un barrido, en milisegundos. Sólo puede hacerla MÁS
# lenta que el piso de 1200 ms: el SII bloquea por patrón de uso, y un barrido
# sin pausa deja al servicio sin ese portal para los tenants reales.
# RITMO_SII_MS=1200

# Tercer nivel de troceo del respaldo XML (POST /v1/mipyme/respaldo-xml): un
# día con tipo_dte puesto que igual excede el tope de 20 documentos se trocea
# por folio (emitidos) o por contraparte (recibidos), combinando tipo_dte con
# folio o con contraparte en la misma llamada al CGI.
#
# Los dos ejes NO tienen el mismo respaldo de evidencia, y por eso cada uno
# tiene SU PROPIA variable — nunca una sola para los dos:
#
#   - RESPALDO_XML_TERCER_NIVEL_FOLIO (eje de emitidos): YA SE VERIFICÓ EN
#     VIVO contra el SII real. Una consulta de un día con un mes cargado,
#     medida dos veces con anchos de rango distintos, respetó tipo_dte y
#     folio a la vez en las dos.
#   - RESPALDO_XML_TERCER_NIVEL_CONTRAPARTE (eje de recibidos): SIGUE SIN
#     VERIFICARSE contra el SII real.
#
# Las dos quedan APAGADAS por defecto: '1' o 'true' (sin importar mayúsculas)
# activa cada una. Partir el interruptor en dos no es una excusa para
# prender nada solo: activar cualquiera de los dos en producción es una
# decisión de despliegue que se toma a conciencia, no un default —cada eje
# abre un frente más de llamadas contra un portal que bloquea por patrón de
# uso—.
#
# Antes de prender RESPALDO_XML_TERCER_NIVEL_CONTRAPARTE en un ambiente que
# atienda `recibidos`, correr src/scripts/verificarRespaldoXml.ts con
# VERIF_TIPO_DTE + VERIF_CONTRAPARTE contra un día real y confirmar que el
# CGI respetó los dos filtros, igual que ya se hizo para folio. Para probar
# VARIAS combinaciones a la vez sin encadenar corridas sueltas (cada una un
# login nuevo al SII — una vez eso dio 3 documentos contra 7 para el mismo
# pedido, sin ninguna página de error), usá VERIF_PLAN de ese mismo script:
# ver README.md.
#
# Aun con folio ya verificado, prenderlo no elimina el riesgo de barrido de
# llamadas que ritmoSii.ts documenta como causa de bloqueo del portal — sólo
# lo acota. Si el CGI llegara a ignorar el filtro de folio/contraparte en
# algún caso no cubierto por la verificación, el tercer nivel puede terminar
# intentando muchas descargas condenadas a fallar contra el mismo día; hay
# topes (TOPE_FOLIOS_UNICOS_POR_DIA, TOPE_PAGINAS_LISTADO, maxTramos) que
# acotan el daño, pero no lo evitan del todo.
#
# COMPATIBILIDAD: RESPALDO_XML_TERCER_NIVEL (el interruptor único original)
# sigue funcionando y prende LOS DOS EJES A LA VEZ si está puesto, para no
# romper a quien ya lo usa. Las variables por eje, si están presentes, tienen
# PRECEDENCIA sobre él (incluso en '0', para poder apagar explícitamente sólo
# el eje no verificado sin tocar el otro).
# RESPALDO_XML_TERCER_NIVEL_FOLIO=1
# RESPALDO_XML_TERCER_NIVEL_CONTRAPARTE=1
# RESPALDO_XML_TERCER_NIVEL=1
